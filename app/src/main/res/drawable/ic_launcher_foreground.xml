<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 
        Replicamos la lógica de la barra:
        1. Mantenemos el alto del icono en 108dp.
        2. Hacemos que la imagen sea mucho más ancha (400dp).
        3. Al centrarla, el sistema recorta los laterales, dejando 
           solo el círculo central, igual que el efecto de la barra.
    -->
    <item
        android:drawable="@drawable/app_logo"
        android:gravity="center"
        android:width="400dp"
        android:height="108dp" />
</layer-list>
